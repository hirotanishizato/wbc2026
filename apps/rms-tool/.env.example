# ===== Server =====
PORT=4000
NODE_ENV=development

# Set to "true" to bypass the real Rakuten RMS API and use built-in fixtures.
# Recommended for local development and demos.
USE_MOCK_RAKUTEN=true

# 32-byte hex key used to encrypt per-tenant API credentials at rest.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_me_with_64_hex_chars

# ===== Supabase =====
# URL and service-role key (server-side only — never ship to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anon key + URL exposed to the browser via Vite.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:4000

# ===== Gemini (platform-default; tenants can override per-tenant) =====
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Rakuten RMS (only used when USE_MOCK_RAKUTEN=false) =====
# Per-tenant credentials are stored in DB (encrypted). Values below are only
# used when running scripts that do not yet have a tenant configured.
RAKUTEN_API_BASE=https://api.rms.rakuten.co.jp
