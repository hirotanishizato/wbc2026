{
  "name": "rms-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rakuten RMS R-Messe inquiry management SaaS with AI auto-reply drafts",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node server/index.js",
    "lint": "eslint server client",
    "db:apply": "node scripts/applyMigrations.js",
    "seed:mock": "node scripts/seedMock.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.0.0",
    "vite": "^7.3.1"
  }
}
